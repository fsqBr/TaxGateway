<Project>
  <!-- Central Package Management (D-111). Linha .NET 10 LTS: pacotes Microsoft.* e Npgsql ficam em 10.x. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- D-W01: referência navegável da API em /docs sobre o OpenAPI gerado. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- Linha 10.x do Microsoft.Extensions.Http.Resilience (Polly v8), compatível com o .NET 10 (D-209). -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.9.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Hardening (D-H01): métricas OpenTelemetry expostas em /metrics (porta de gestão) para Prometheus, SLOs e canário. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2.1" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.3.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
